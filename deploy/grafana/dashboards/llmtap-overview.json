{
  "title": "LLM Observability — llmtap",
  "uid": "llmtap-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["llmtap", "genai"],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(gen_ai_client_operation_duration_seconds_count, gen_ai_request_model)", "refId": "ModelQuery" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / second by model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{gen_ai_request_model=~\"$model\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 / p95 / p99 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_request_model=~\"$model\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_request_model=~\"$model\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_request_model=~\"$model\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Time to first token (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_time_to_first_token_seconds_bucket{gen_ai_request_model=~\"$model\"}[5m])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens / second (input vs output)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type, gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} / {{token_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Estimated cost ($/hour)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_cost_usd_total{gen_ai_request_model=~\"$model\"}[5m])) * 3600",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate (5xx / total)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llmtap_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(llmtap_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx ratio"
        },
        {
          "refId": "B",
          "expr": "sum by (http_response_status_code) (rate(gen_ai_client_operation_duration_seconds_count{http_response_status_code=~\"[45]..\",gen_ai_request_model=~\"$model\"}[5m]))",
          "legendFormat": "gen_ai status {{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Proxy self-health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "stat",
      "title": "In-flight requests",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(llmtap_requests_in_flight)" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active streams",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(llmtap_streams_active)" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Circuit breaker state (0=closed 1=open 2=half_open)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmtap_breaker_state",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rejects / second by reason",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(llmtap_requests_rejected_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "OTLP export errors / second",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llmtap_telemetry_export_errors_total[5m]))",
          "legendFormat": "export errors"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Stream idle timeouts / second",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream) (rate(llmtap_streams_idle_timeouts_total[5m]))",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Pricing misses / second",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llmtap_pricing_misses_total[5m]))",
          "legendFormat": "misses"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "TLS cert NotAfter (unix)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "llmtap_tls_cert_not_after_seconds" }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Total requests (counter)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(llmtap_requests_total)" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Auth rejects / second",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llmtap_auth_rejected_total[5m]))",
          "legendFormat": "auth 401"
        }
      ]
    }
  ]
}
